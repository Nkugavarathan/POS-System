# Copy to backend/.env for local development (git-ignored), or provide these as real
# environment variables. Never commit real values.

# JDBC URL. MySQL 8: jdbc:mysql://...  MariaDB/XAMPP: jdbc:mariadb://localhost:3306/pos_dev
# The Hibernate dialect is detected automatically.
DB_URL=jdbc:mysql://localhost:3306/pos_dev?connectionTimeZone=UTC&preserveInstants=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true
# Used only by integration tests (*IT). The schema is CLEANED on every test run - point it at a throwaway database.
TEST_DB_URL=jdbc:mysql://localhost:3306/pos_test?connectionTimeZone=UTC&preserveInstants=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=pos_app
DB_PASSWORD=change-me

# HS256 signing key for access tokens: at least 32 random bytes, base64.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Optional
# SERVER_PORT=8080
# MANAGEMENT_PORT=8081
# APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
# COOKIE_SECURE=true
# API_DOCS_ENABLED=false
